# Non-secret reference only. init_local.py creates ignored .env with random LOCAL credentials.
# Copy chosen values into ignored .env.telegram (mode 0600), never into CLI arguments.
# Telegram is disabled unless explicitly enabled; all default loopback services still work.
ASM_TELEGRAM_ENABLED=false
TG_BOT_TOKEN=
TG_WEBHOOK_SECRET=
ASM_TELEGRAM_EXPECTED_BOT_ID=
ASM_TELEGRAM_WEBHOOK_URL=

# Live LOCAL/TEST requires operator-owned DNS, public HTTPS and valid TLS certificates.
# Follow docs/runbooks/M2_TELEGRAM_LOCAL_TEST.md before enabling any profile.
# ASM_TELEGRAM_CONSOLE_HOST=console.telegram-test.example.net
# ASM_TELEGRAM_STORAGE_HOST=files.telegram-test.example.net
# ASM_AUTH_ORIGINS=["https://console.telegram-test.example.net"]
# ASM_STORAGE_ENDPOINT=https://files.telegram-test.example.net
# Export ASM_TELEGRAM_INGRESS_UID/GID from the non-root operator's id -u/id -g.
# These are non-secret; they allow the TLS container to read operator-owned 0600 keys.

# Operator setup only: fresh Workspace/Business, independently approved Telegram Owner.
ASM_TELEGRAM_WORKSPACE_ID=
ASM_TELEGRAM_BUSINESS_ID=
ASM_TELEGRAM_EXPECTED_OWNER_ID=
ASM_TELEGRAM_CONNECTION_ID=
ASM_TELEGRAM_BILLING_CONTACT=
ASM_TELEGRAM_BILLING_FROM=
ASM_TELEGRAM_BILLING_UNTIL=

# Live smoke only: distinct owner API credentials, no bot or migrator credentials.
ASM_TELEGRAM_SMOKE_ORIGIN=
ASM_TELEGRAM_SMOKE_LOGIN=
ASM_TELEGRAM_SMOKE_PASSWORD=
ASM_TELEGRAM_SMOKE_CONNECTION_ID=
ASM_TELEGRAM_SMOKE_MARKER=
ASM_TELEGRAM_SMOKE_CONVERSATION_ID=
ASM_TELEGRAM_SMOKE_CLIENT_ID=
ASM_TELEGRAM_SMOKE_REPLY=
ASM_TELEGRAM_SMOKE_KEY=
ASM_TELEGRAM_SMOKE_APPROVAL=
