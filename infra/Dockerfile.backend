ARG UV_IMAGE
ARG PYTHON_IMAGE
FROM ${UV_IMAGE} AS uvbin
FROM ${PYTHON_IMAGE} AS toolchain
COPY --from=uvbin /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH" PYTHONPATH=/app/backend/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

FROM toolchain AS development
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project
COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
COPY tests ./tests
COPY scripts ./scripts
COPY contracts ./contracts
COPY infra/postgres/ensure_m1_3_prerequisites.sh ./infra/postgres/ensure_m1_3_prerequisites.sh
CMD ["sh", "scripts/check_backend.sh"]

FROM toolchain AS runtime
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "asm.foundation:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
