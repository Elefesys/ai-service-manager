{
  "$defs": {
    "Handoff": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "handoff",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "reason"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "NoReply": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "no_reply",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "null"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "reason"
      ],
      "title": "NoReply",
      "type": "object"
    },
    "PortfolioPhoto": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "portfolio_photo",
          "title": "Kind",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/PortfolioPhotoSelection"
        },
        "caption": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "selection",
        "caption"
      ],
      "title": "PortfolioPhoto",
      "type": "object"
    },
    "PortfolioPhotoSelection": {
      "additionalProperties": false,
      "description": "Only a source identity; never destination, storage access, or a permit.",
      "properties": {
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "asset_version_id": {
          "format": "uuid",
          "title": "Asset Version Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "revision_id",
        "asset_version_id",
        "source_sha256"
      ],
      "title": "PortfolioPhotoSelection",
      "type": "object"
    },
    "Reply": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "reply",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "null"
        }
      },
      "required": [
        "kind",
        "text",
        "reason"
      ],
      "title": "Reply",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Reply"
    },
    {
      "$ref": "#/$defs/Handoff"
    },
    {
      "$ref": "#/$defs/NoReply"
    },
    {
      "$ref": "#/$defs/PortfolioPhoto"
    }
  ]
}
